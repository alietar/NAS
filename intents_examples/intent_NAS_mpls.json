{
  "gns_auto_config": {
    "enable": true,
    "host": "127.0.0.1",
    "port": "3080",
    "project_name": "NAS IPv4 MPLS VPN",
    "create_routers": true,
    "create_links": true,
    "arrange_automagically": true,
    "auto_fetch_router_infos": true,
    "auto_create_address":
      {
        "physical" : true,
        "Loopback" : true
      }
  },

  "write" : false,
  "ip_version": "ipv4",

  "as": [
    { "asn": 1, "internal_protocol": "OSPF" },
    { "asn": 2, "internal_protocol": "OSPF" },
    { "asn": 3, "internal_protocol": "OSPF" },
    { "asn": 4, "internal_protocol": "OSPF" },
    { "asn": 5, "internal_protocol": "OSPF" }
  ],

  "routers": [
    { "name": "A1",  "asn": 1 },
    { "name": "A2",  "asn": 1 },
    { "name": "B3",  "asn": 2 },
    { "name": "B4",  "asn": 2 },
    { "name": "Z5",  "asn": 3 },
    { "name": "Z6",  "asn": 3 },
    { "name": "Z7",  "asn": 3 },
    { "name": "Z8",  "asn": 3 },
    { "name": "C9",  "asn": 4 },
    { "name": "C10",  "asn": 4 },
    { "name": "D11",  "asn": 5 },
    { "name": "D12",  "asn": 5 }
  ],

  "links": [
    {
      "from": "A1",
      "to": "A2",
      "interface_from": "g1/0",
      "interface_to": "g2/0"
    },
    {
      "from": "A2",
      "to": "Z5",
      "interface_from": "g1/0",
      "interface_to": "g2/0"
    },
    {
      "from": "B3",
      "to": "B4",
      "interface_from": "g1/0",
      "interface_to": "g2/0"
    },
    {
      "from": "B4",
      "to": "Z5",
      "interface_from": "g1/0",
      "interface_to": "g3/0"
    },
    {
      "from": "Z5",
      "to": "Z6",
      "interface_from": "g1/0",
      "interface_to": "g2/0"
    },
    {
      "from": "Z6",
      "to": "Z7",
      "interface_from": "g1/0",
      "interface_to": "g2/0"
    },
    {
      "from": "Z7",
      "to": "Z8",
      "interface_from": "g1/0",
      "interface_to": "g1/0"
    },
    {
      "from": "C9",
      "to": "Z8",
      "interface_from": "g1/0",
      "interface_to": "g2/0"
    },
    {
      "from": "C10",
      "to": "C9",
      "interface_from": "g1/0",
      "interface_to": "g2/0"
    },
    {
      "from": "D11",
      "to": "Z8",
      "interface_from": "g1/0",
      "interface_to": "g3/0"
    },
    {
      "from": "D12",
      "to": "D11",
      "interface_from": "g1/0",
      "interface_to": "g2/0"
    }
  ],

  "vpn": [
    {
      "client_name": "client2",
      "client_asn_list": [1, 4],
      "provider_asn": 3
    },
    {
      "client_name": "client1",
      "client_asn_list": [2, 5],
      "provider_asn": 3
    }
  ]
}
