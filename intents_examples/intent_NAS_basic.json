{
  "gns_auto_config": {
    "enable": true,
    "host": "127.0.0.1",
    "port": "3080",
    "project_name": "NAS IPv4 Basic",
    "create_routers": true,
    "create_links": true,
    "arrange_automagically": true,
    "auto_fetch_router_infos": true,
    "auto_create_address":
      {
        "physical" : true,
        "Loopback" : true
      }
  },

  "write" : true,
  "ip_version": "ipv4",

  "as": [
    { "asn": 1, "internal_protocol": "OSPF" },
    { "asn": 2, "internal_protocol": "OSPF" },
    { "asn": 3, "internal_protocol": "OSPF" }

  ],

  "routers": [
    { "name": "A1",  "asn": 1 },
    { "name": "B2",  "asn": 2 },
    { "name": "B3",  "asn": 2 },
    { "name": "C4",  "asn": 3 }
  ],

  "links": [
    {
      "from": "A1",
      "to": "B2",
      "interface_from": "g1/0",
      "interface_to": "g1/0"
    },
    {
      "from": "B2",
      "to": "B3",
      "interface_from": "g2/0",
      "interface_to": "g2/0"
    },
    {
      "from": "B3",
      "to": "C4",
      "interface_from": "g1/0",
      "interface_to": "g1/0"
    }
  ]
}
